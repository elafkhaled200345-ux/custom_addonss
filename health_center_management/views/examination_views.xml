<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ══════════════════════════════════════════════════════
             PATIENT PORTAL — Examinations (Read Only + Download)
        ══════════════════════════════════════════════════════ -->

        <record id="view_health_examination_patient_tree" model="ir.ui.view">
            <field name="name">health.examination.list.patient</field>
            <field name="model">health.examination</field>
            <field name="arch" type="xml">
                <list string="My Examinations" create="0" delete="0">
                    <field name="name" string="Exam Number"/>
                    <field name="booking_number" string="Booking Number"/>
                    <field name="create_date_manual" string="Date"/>
                    <field name="result" string="Result"/>
                </list>
            </field>
        </record>

        <record id="view_health_examination_patient_form" model="ir.ui.view">
            <field name="name">health.examination.form.patient</field>
            <field name="model">health.examination</field>
            <field name="arch" type="xml">
                <form string="My Examination" create="false" delete="false">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Patient Information">
                                <field name="patient_name" string="Patient Name" readonly="1"/>
                                <field name="booking_number" string="Booking Number" readonly="1"/>
                                <field name="medical_record_number" string="Record Number" readonly="1"/>
                                <field name="create_date_manual" string="Date" readonly="1"/>
                            </group>
                        </group>
                        <group string="Examination Result">
                            <field name="result" nolabel="1" readonly="1"/>
                        </group>
                        <group string="Drug Prescription">
                            <field name="prescription" nolabel="1" readonly="1"/>
                        </group>
                        <footer>
                            <button name="action_download_report"
                                    string="Download PDF Report"
                                    type="object"
                                    class="btn-primary"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════
             DOCTOR PORTAL — Examinations (Full Add + Edit + Save Confirm)
        ══════════════════════════════════════════════════════ -->

        <record id="view_health_examination_doctor_tree" model="ir.ui.view">
            <field name="name">health.examination.list.doctor</field>
            <field name="model">health.examination</field>
            <field name="arch" type="xml">
                <list string="Examinations">
                    <field name="name" string="Exam Number"/>
                    <field name="patient_name" string="Patient Name"/>
                    <field name="booking_number" string="Booking Number"/>
                    <field name="create_date_manual" string="Date"/>
                    <field name="result" string="Result" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_health_examination_doctor_form" model="ir.ui.view">
            <field name="name">health.examination.form.doctor</field>
            <field name="model">health.examination</field>
            <field name="arch" type="xml">
                <form string="Examination">
                    <header>
                        <button name="action_save_confirm"
                                string="✔ Save &amp; Confirm"
                                type="object"
                                class="btn-primary"
                                data-hotkey="s"/>
                        <button string="Discard Changes"
                                class="btn-secondary"
                                special="cancel"
                                confirm="Are you sure you want to discard changes? All unsaved data will be lost."/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Exam Number"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Patient Information">
                                <field name="medical_record_id" string="Medical Record"/>
                                <field name="patient_name" string="Patient Name" readonly="1"/>
                                <field name="booking_number" string="Booking Number" readonly="1"/>
                                <field name="create_date_manual" string="Date"/>
                            </group>
                        </group>
                        <group string="Medical Report (Reference)">
                            <field name="medical_record_report" nolabel="1" readonly="1"/>
                        </group>
                        <group string="Examination Result">
                            <field name="result" nolabel="1"
                                   placeholder="Write examination result here..."/>
                        </group>
                        <group string="Drug Prescription">
                            <field name="prescription" nolabel="1"
                                   placeholder="Write drug prescription here..."/>
                        </group>
                        <footer>
                            <button name="action_print_examination"
                                    string="Print Report"
                                    type="object"
                                    class="btn-secondary"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════
             EMPLOYEE PORTAL — Examinations (Full Add + Edit + Save Confirm)
        ══════════════════════════════════════════════════════ -->

        <record id="view_health_examination_employee_tree" model="ir.ui.view">
            <field name="name">health.examination.list.employee</field>
            <field name="model">health.examination</field>
            <field name="arch" type="xml">
                <list string="Examinations">
                    <field name="name" string="Exam Number"/>
                    <field name="patient_name" string="Patient Name"/>
                    <field name="booking_number" string="Booking Number"/>
                    <field name="create_date_manual" string="Date"/>
                    <field name="result" string="Result" optional="show"/>
                    <field name="prescription" string="Prescription" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_health_examination_employee_form" model="ir.ui.view">
            <field name="name">health.examination.form.employee</field>
            <field name="model">health.examination</field>
            <field name="arch" type="xml">
                <form string="Examination">
                    <header>
                        <button name="action_save_confirm"
                                string="✔ Save &amp; Confirm"
                                type="object"
                                class="btn-primary"
                                data-hotkey="s"/>
                        <button string="Discard Changes"
                                class="btn-secondary"
                                special="cancel"
                                confirm="Are you sure you want to discard changes? All unsaved data will be lost."/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Exam Number"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Patient Information">
                                <field name="medical_record_id" string="Medical Record"/>
                                <field name="patient_name" string="Patient Name" readonly="1"/>
                                <field name="booking_number" string="Booking Number" readonly="1"/>
                                <field name="medical_record_number" string="Record Number" readonly="1"/>
                                <field name="create_date_manual" string="Date"/>
                            </group>
                        </group>
                        <group string="Examination Result">
                            <field name="result" nolabel="1"
                                   placeholder="Write examination result here..."/>
                        </group>
                        <group string="Drug Prescription">
                            <field name="prescription" nolabel="1"
                                   placeholder="Write drug prescription here..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════
             PHARMACY / LABORATORY — Read Only
        ══════════════════════════════════════════════════════ -->

        <record id="view_health_examination_pharmacy_tree" model="ir.ui.view">
            <field name="name">health.examination.list.pharmacy</field>
            <field name="model">health.examination</field>
            <field name="arch" type="xml">
                <list string="Patient Examinations" create="0" delete="0">
                    <field name="name" string="Exam Number"/>
                    <field name="patient_name" string="Patient Name"/>
                    <field name="booking_number" string="Booking Number"/>
                    <field name="create_date_manual" string="Date"/>
                    <field name="result" string="Result"/>
                    <field name="prescription" string="Prescription"/>
                </list>
            </field>
        </record>

        <record id="view_health_examination_form_pharmacy" model="ir.ui.view">
            <field name="name">health.examination.form.pharmacy</field>
            <field name="model">health.examination</field>
            <field name="arch" type="xml">
                <form string="Examination Details" create="false" delete="false">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Patient Information">
                                <field name="patient_name" string="Patient Name" readonly="1"/>
                                <field name="booking_number" string="Booking Number" readonly="1"/>
                                <field name="medical_record_number" string="Record Number" readonly="1"/>
                                <field name="create_date_manual" string="Date" readonly="1"/>
                            </group>
                        </group>
                        <group string="Examination Result">
                            <field name="result" nolabel="1" readonly="1"/>
                        </group>
                        <group string="Drug Prescription">
                            <field name="prescription" nolabel="1" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_health_examination_search" model="ir.ui.view">
            <field name="name">health.examination.search</field>
            <field name="model">health.examination</field>
            <field name="arch" type="xml">
                <search string="Search Examinations">
                    <field name="name" string="Exam Number"/>
                    <field name="patient_name" string="Patient Name"/>
                    <field name="booking_number" string="Booking Number"/>
                </search>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_health_examination_patient" model="ir.actions.act_window">
            <field name="name">Download Medical Report</field>
            <field name="res_model">health.examination</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_health_examination_patient_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_health_examination_patient_form')}),
            ]"/>
            <field name="search_view_id" ref="view_health_examination_search"/>
            <field name="context">{'create': False}</field>
            <field name="groups_id" eval="[(4, ref('health_center_management.group_health_patient'))]"/>
        </record>

        <record id="action_health_examination_doctor" model="ir.actions.act_window">
            <field name="name">Examinations</field>
            <field name="res_model">health.examination</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_health_examination_doctor_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_health_examination_doctor_form')}),
            ]"/>
            <field name="search_view_id" ref="view_health_examination_search"/>
            <field name="groups_id" eval="[(4, ref('health_center_management.group_health_doctor'))]"/>
        </record>

        <record id="action_health_examination_employee" model="ir.actions.act_window">
            <field name="name">Examinations</field>
            <field name="res_model">health.examination</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_health_examination_employee_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_health_examination_employee_form')}),
            ]"/>
            <field name="search_view_id" ref="view_health_examination_search"/>
            <field name="groups_id" eval="[(4, ref('health_center_management.group_health_employee'))]"/>
        </record>

        <record id="action_health_pharmacy" model="ir.actions.act_window">
            <field name="name">Pharmacy</field>
            <field name="res_model">health.examination</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_health_examination_pharmacy_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_health_examination_form_pharmacy')}),
            ]"/>
            <field name="search_view_id" ref="view_health_examination_search"/>
            <field name="context">{'create': False}</field>
        </record>

        <record id="action_health_laboratory" model="ir.actions.act_window">
            <field name="name">Laboratory</field>
            <field name="res_model">health.examination</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_health_examination_pharmacy_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_health_examination_form_pharmacy')}),
            ]"/>
            <field name="search_view_id" ref="view_health_examination_search"/>
            <field name="context">{'create': False}</field>
        </record>

    </data>
</odoo>
