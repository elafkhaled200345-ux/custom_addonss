<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_examination_list" model="ir.ui.view">
        <field name="name">health.examination.list</field>
        <field name="model">health.examination</field>
        <field name="arch" type="xml">
            <list string="Examinations / الفحوصات" default_order="id desc">
                <field name="name"/>
                <field name="patient_name"/>
                <field name="clinic_id"/>
                <field name="doctor_id"/>
                <field name="examination_name"/>
                <field name="examination_type"/>
                <field name="create_date_manual" string="Date"/>
                <field name="performed_by"/>
                <field name="examination_fees" string="Fee (SAR)"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_health_examination_form" model="ir.ui.view">
        <field name="name">health.examination.form</field>
        <field name="model">health.examination</field>
        <field name="arch" type="xml">
            <form string="Examination / فحص طبي">
                <header>
                    <button name="action_mark_done" string="Mark Done / اعتماد"
                            type="object" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_print_examination" string="🖨 Print Report / طباعة"
                            type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Patient / المريض">
                            <field name="medical_record_id"/>
                            <field name="patient_name" readonly="1"/>
                            <field name="booking_number" readonly="1"/>
                            <field name="clinic_id" readonly="1"/>
                            <field name="doctor_id" readonly="1"/>
                        </group>
                        <group string="Examination / الفحص">
                            <field name="examination_name"/>
                            <field name="examination_type"/>
                            <field name="create_date_manual"/>
                            <field name="performed_by"/>
                            <field name="examination_fees"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Result / النتيجة">
                            <field name="result" placeholder="Examination result / نتيجة الفحص"/>
                        </page>
                        <page string="Prescription / الوصفة">
                            <field name="prescription" placeholder="Drug prescription / الوصفة الطبية"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Patient view — read only -->
    <record id="view_health_examination_patient_list" model="ir.ui.view">
        <field name="name">health.examination.list.patient</field>
        <field name="model">health.examination</field>
        <field name="arch" type="xml">
            <list string="My Examinations" create="0" delete="0" edit="0">
                <field name="name"/>
                <field name="booking_number"/>
                <field name="create_date_manual" string="Date"/>
                <field name="performed_by"/>
                <field name="examination_name"/>
                <field name="result"/>
            </list>
        </field>
    </record>

    <record id="action_health_examination" model="ir.actions.act_window">
        <field name="name">Examinations / الفحوصات</field>
        <field name="res_model">health.examination</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_health_examination_patient" model="ir.actions.act_window">
        <field name="name">My Examinations / فحوصاتي</field>
        <field name="res_model">health.examination</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_health_examination_patient_list"/>
    </record>
</odoo>
