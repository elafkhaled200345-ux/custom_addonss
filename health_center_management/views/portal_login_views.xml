<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_portal_login_form" model="ir.ui.view">
        <field name="name">health.portal.login.form</field>
        <field name="model">health.portal.login</field>
        <field name="arch" type="xml">
            <form string="Portal Login / دخول البوابة">
                <sheet>
                    <div class="text-center mb-4">
                        <h2>🔐 Portal Login / دخول البوابة</h2>
                        <p class="text-muted">
                            Select portal type and enter your password to continue.
                        </p>
                    </div>
                    <group>
                        <field name="portal_type" widget="radio"/>
                        <field name="doctor_id"
                               invisible="portal_type != 'doctor'"
                               required="portal_type == 'doctor'"/>
                        <field name="employee_id"
                               invisible="portal_type != 'employee'"/>
                        <field name="password" password="True"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_verify" string="🔑 Login / دخول"
                            type="object" class="btn-primary"/>
                    <button string="Cancel / إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_employee_portal_login" model="ir.actions.act_window">
        <field name="name">Employee Portal / بوابة الموظف</field>
        <field name="res_model">health.portal.login</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_health_portal_login_form"/>
        <field name="context">{'default_portal_type': 'employee'}</field>
        <field name="target">new</field>
    </record>

    <record id="action_doctor_portal_login" model="ir.actions.act_window">
        <field name="name">Doctor Portal / بوابة الطبيب</field>
        <field name="res_model">health.portal.login</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_health_portal_login_form"/>
        <field name="context">{'default_portal_type': 'doctor'}</field>
        <field name="target">new</field>
    </record>
</odoo>
