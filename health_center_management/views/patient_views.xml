<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Shared Search View -->
        <record id="view_health_patient_search" model="ir.ui.view">
            <field name="name">health.patient.search</field>
            <field name="model">health.patient</field>
            <field name="arch" type="xml">
                <search string="Search Patients">
                    <field name="name" string="Patient Name"/>
                    <field name="phone" string="Phone"/>
                    <field name="clinic_id" string="Clinic"/>
                    <field name="booking_number" string="Booking Number"/>
                    <filter name="draft" string="Draft"
                            domain="[('state', '=', 'draft')]"/>
                    <filter name="confirmed" string="Confirmed"
                            domain="[('state', '=', 'confirmed')]"/>
                    <filter name="cancelled" string="Cancelled"
                            domain="[('state', '=', 'cancelled')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_clinic" string="Clinic"
                                context="{'group_by': 'clinic_id'}"/>
                        <filter name="group_state" string="Status"
                                context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════
             PATIENT PORTAL — Book Appointment
        ══════════════════════════════════════════════════════ -->

        <record id="view_health_patient_patient_tree" model="ir.ui.view">
            <field name="name">health.patient.list.patient</field>
            <field name="model">health.patient</field>
            <field name="arch" type="xml">
                <list string="My Bookings" create="1" delete="0">
                    <field name="name" string="Patient Name"/>
                    <field name="clinic_id" string="Clinic"/>
                    <field name="booking_type" string="Booking Type"/>
                    <field name="booking_number" string="Booking Number"/>
                    <field name="state" string="Status" widget="badge"
                           decoration-success="state == 'confirmed'"
                           decoration-warning="state == 'draft'"
                           decoration-danger="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <record id="view_health_patient_patient_form" model="ir.ui.view">
            <field name="name">health.patient.form.patient</field>
            <field name="model">health.patient</field>
            <field name="arch" type="xml">
                <form string="Book Appointment">
                    <header>
                        <button name="action_confirm_booking"
                                string="✔ Confirm Booking"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_cancel_booking"
                                string="✖ Cancel Booking"
                                type="object"
                                class="btn-danger"
                                invisible="state == 'cancelled'"
                                confirm="Are you sure you want to cancel this booking?"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Patient Name"/></h1>
                        </div>
                        <group>
                            <group string="Personal Information">
                                <field name="phone" string="Phone"/>
                                <field name="birthdate" string="Date of Birth"/>
                                <field name="gender" string="Gender"/>
                            </group>
                            <group string="Booking Details">
                                <field name="booking_type" string="Booking Type"/>
                                <field name="clinic_id" string="Clinic"/>
                                <field name="appointment_id" string="Appointment Time"
                                       domain="[('clinic_id', '=', clinic_id), ('is_available', '=', True)]"/>
                                <field name="booking_number" string="Booking Number" readonly="1"/>
                            </group>
                        </group>
                        <group invisible="booking_type != 'followup'" string="Follow-Up Information">
                            <field name="followup_booking_number"
                                   string="Previous Booking Number"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════
             DOCTOR PORTAL — My Clinic Patients
        ══════════════════════════════════════════════════════ -->

        <record id="view_health_patient_doctor_tree" model="ir.ui.view">
            <field name="name">health.patient.list.doctor</field>
            <field name="model">health.patient</field>
            <field name="arch" type="xml">
                <list string="My Clinic Patients" create="0" delete="0">
                    <field name="name" string="Patient Name"/>
                    <field name="phone" string="Phone"/>
                    <field name="clinic_id" string="Clinic"/>
                    <field name="booking_type" string="Type"/>
                    <field name="booking_number" string="Booking Number"/>
                    <field name="state" string="Status" widget="badge"
                           decoration-success="state == 'confirmed'"
                           decoration-warning="state == 'draft'"
                           decoration-danger="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <record id="view_health_patient_doctor_form" model="ir.ui.view">
            <field name="name">health.patient.form.doctor</field>
            <field name="model">health.patient</field>
            <field name="arch" type="xml">
                <form string="Patient Details" create="false" delete="false">
                    <header>
                        <button name="action_save_confirm"
                                string="✔ Save &amp; Confirm"
                                type="object"
                                class="btn-primary"
                                data-hotkey="s"/>
                        <button name="action_confirm_booking"
                                string="✔ Confirm Booking"
                                type="object"
                                class="btn-success"
                                invisible="state != 'draft'"/>
                        <button name="action_cancel_booking"
                                string="✖ Cancel Booking"
                                type="object"
                                class="btn-danger"
                                invisible="state == 'cancelled'"
                                confirm="Are you sure you want to cancel this booking?"/>
                        <button string="Discard Changes"
                                class="btn-secondary"
                                special="cancel"
                                confirm="Are you sure you want to discard changes? All unsaved data will be lost."/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Personal Information">
                                <field name="phone" string="Phone"/>
                                <field name="birthdate" string="Date of Birth"/>
                                <field name="gender" string="Gender"/>
                            </group>
                            <group string="Booking Details">
                                <field name="booking_type" string="Booking Type"/>
                                <field name="clinic_id" string="Clinic"/>
                                <field name="booking_number" string="Booking Number" readonly="1"/>
                            </group>
                        </group>
                        <group string="Medical Record">
                            <field name="medical_record_id" string="Medical Record"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════
             EMPLOYEE PORTAL — Manage Patients
        ══════════════════════════════════════════════════════ -->

        <record id="view_health_patient_employee_tree" model="ir.ui.view">
            <field name="name">health.patient.list.employee</field>
            <field name="model">health.patient</field>
            <field name="arch" type="xml">
                <list string="Patients">
                    <field name="name" string="Patient Name"/>
                    <field name="phone" string="Phone"/>
                    <field name="clinic_id" string="Clinic"/>
                    <field name="booking_type" string="Type"/>
                    <field name="booking_number" string="Booking Number"/>
                    <field name="state" string="Status" widget="badge"
                           decoration-success="state == 'confirmed'"
                           decoration-warning="state == 'draft'"
                           decoration-danger="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <record id="view_health_patient_employee_form" model="ir.ui.view">
            <field name="name">health.patient.form.employee</field>
            <field name="model">health.patient</field>
            <field name="arch" type="xml">
                <form string="Patient">
                    <header>
                        <button name="action_save_confirm"
                                string="✔ Save &amp; Confirm"
                                type="object"
                                class="btn-primary"
                                data-hotkey="s"/>
                        <button name="action_confirm_booking"
                                string="✔ Confirm Booking"
                                type="object"
                                class="btn-success"
                                invisible="state != 'draft'"/>
                        <button name="action_cancel_booking"
                                string="✖ Cancel Booking"
                                type="object"
                                class="btn-danger"
                                invisible="state == 'cancelled'"
                                confirm="Are you sure you want to cancel this booking?"/>
                        <button string="Discard Changes"
                                class="btn-secondary"
                                special="cancel"
                                confirm="Are you sure you want to discard changes? All unsaved data will be lost."/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Patient Name"/></h1>
                        </div>
                        <group>
                            <group string="Personal Information">
                                <field name="phone" string="Phone"/>
                                <field name="birthdate" string="Date of Birth"/>
                                <field name="gender" string="Gender"/>
                            </group>
                            <group string="Booking Details">
                                <field name="booking_type" string="Booking Type"/>
                                <field name="clinic_id" string="Clinic"/>
                                <field name="appointment_id" string="Appointment Time"
                                       domain="[('clinic_id', '=', clinic_id), ('is_available', '=', True)]"/>
                                <field name="booking_number" string="Booking Number" readonly="1"/>
                            </group>
                        </group>
                        <group invisible="booking_type != 'followup'" string="Follow-Up Information">
                            <field name="followup_booking_number" string="Previous Booking Number"/>
                        </group>
                        <group string="Medical Record">
                            <field name="medical_record_id" string="Medical Record"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_health_patient_book" model="ir.actions.act_window">
            <field name="name">Book Your Appointment</field>
            <field name="res_model">health.patient</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_health_patient_patient_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_health_patient_patient_form')}),
            ]"/>
            <field name="search_view_id" ref="view_health_patient_search"/>
            <field name="groups_id" eval="[(4, ref('health_center_management.group_health_patient'))]"/>
        </record>

        <record id="action_health_patient_doctor" model="ir.actions.act_window">
            <field name="name">My Clinic Patients</field>
            <field name="res_model">health.patient</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_health_patient_doctor_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_health_patient_doctor_form')}),
            ]"/>
            <field name="search_view_id" ref="view_health_patient_search"/>
            <field name="groups_id" eval="[(4, ref('health_center_management.group_health_doctor'))]"/>
        </record>

        <record id="action_health_patient_employee" model="ir.actions.act_window">
            <field name="name">Manage Patients</field>
            <field name="res_model">health.patient</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_health_patient_employee_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_health_patient_employee_form')}),
            ]"/>
            <field name="search_view_id" ref="view_health_patient_search"/>
            <field name="groups_id" eval="[(4, ref('health_center_management.group_health_employee'))]"/>
        </record>

    </data>
</odoo>
