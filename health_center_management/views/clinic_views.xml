<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List -->
    <record id="view_health_clinic_list" model="ir.ui.view">
        <field name="name">health.clinic.list</field>
        <field name="model">health.clinic</field>
        <field name="arch" type="xml">
            <list string="Clinics / العيادات" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="specialty"/>
                <field name="phone"/>
                <field name="doctor_count" string="Doctors"/>
                <field name="appointment_count" string="Appointments"/>
                <field name="status_label" string="Status Today"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_health_clinic_kanban" model="ir.ui.view">
        <field name="name">health.clinic.kanban</field>
        <field name="model">health.clinic</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_order="sequence">
                <field name="name"/>
                <field name="specialty"/>
                <field name="status"/>
                <field name="status_label"/>
                <field name="doctor_count"/>
                <field name="appointment_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <strong><field name="name"/></strong>
                                    </div>
                                    <div class="o_secondary text-muted">
                                        <field name="specialty"/>
                                    </div>
                                </div>
                                <div class="o_kanban_manage_button_section">
                                    <span t-att-class="record.status.raw_value ? 'badge bg-success' : 'badge bg-danger'">
                                        <field name="status_label"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_card_content row mt-2">
                                <div class="col-6 text-center">
                                    <strong><field name="doctor_count"/></strong>
                                    <br/><small class="text-muted">Doctors</small>
                                </div>
                                <div class="col-6 text-center">
                                    <strong><field name="appointment_count"/></strong>
                                    <br/><small class="text-muted">Appts</small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form -->
    <record id="view_health_clinic_form" model="ir.ui.view">
        <field name="name">health.clinic.form</field>
        <field name="model">health.clinic</field>
        <field name="arch" type="xml">
            <form string="Clinic / عيادة">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Clinic Name / اسم العيادة"/></h1>
                        <h3 class="text-muted"><field name="specialty" placeholder="Specialty / التخصص"/></h3>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-user-md"
                                type="object" name="action_view_doctors">
                            <field name="doctor_count" widget="statinfo" string="Doctors"/>
                        </button>
                    </div>
                    <group>
                        <group string="Contact / التواصل">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="location"/>
                        </group>
                        <group string="Status / الحالة">
                            <field name="status_label" string="Today's Status"/>
                            <field name="active"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Doctors / الأطباء">
                            <field name="doctor_ids" context="{'default_clinic_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="speciality"/>
                                    <field name="consultation_fee"/>
                                    <field name="phone"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Patient-facing (read only) -->
    <record id="view_health_clinic_patient_list" model="ir.ui.view">
        <field name="name">health.clinic.list.patient</field>
        <field name="model">health.clinic</field>
        <field name="arch" type="xml">
            <list string="Available Clinics / العيادات المتاحة" create="0" delete="0" edit="0">
                <field name="name" string="Clinic / العيادة"/>
                <field name="specialty" string="Specialty / التخصص"/>
                <field name="status_label" string="Status Today / حالة اليوم"/>
            </list>
        </field>
    </record>

    <record id="action_health_clinic" model="ir.actions.act_window">
        <field name="name">Clinics / العيادات</field>
        <field name="res_model">health.clinic</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_health_clinic_patient" model="ir.actions.act_window">
        <field name="name">Available Clinics / العيادات المتاحة</field>
        <field name="res_model">health.clinic</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active', '=', True)]</field>
    </record>
</odoo>
