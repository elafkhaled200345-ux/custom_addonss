<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_medical_record_list" model="ir.ui.view">
        <field name="name">health.medical.record.list</field>
        <field name="model">health.medical.record</field>
        <field name="arch" type="xml">
            <list string="Medical Records / السجلات الطبية" default_order="id desc">
                <field name="name" string="Record #"/>
                <field name="patient_name"/>
                <field name="clinic_id"/>
                <field name="doctor_id"/>
                <field name="create_date_manual" string="Visit Date"/>
                <field name="diagnosis_code" optional="show"/>
                <field name="diagnosis" optional="hide"/>
                <field name="follow_up_date" optional="show"/>
                <field name="examination_count" string="Exams"/>
                <field name="lab_request_count" string="Labs"/>
            </list>
        </field>
    </record>

    <record id="view_health_medical_record_form" model="ir.ui.view">
        <field name="name">health.medical.record.form</field>
        <field name="model">health.medical.record</field>
        <field name="arch" type="xml">
            <form string="Medical Record / السجل الطبي">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_examinations" type="object"
                                class="oe_stat_button" icon="fa-stethoscope">
                            <field name="examination_count" widget="statinfo" string="Examinations"/>
                        </button>
                        <button name="action_view_lab_requests" type="object"
                                class="oe_stat_button" icon="fa-flask">
                            <field name="lab_request_count" widget="statinfo" string="Lab Requests"/>
                        </button>
                        <button name="action_view_prescriptions" type="object"
                                class="oe_stat_button" icon="fa-medkit">
                            <field name="prescription_count" widget="statinfo" string="Prescriptions"/>
                        </button>
                        <button name="action_create_followup_appointment" type="object"
                                class="oe_stat_button" icon="fa-calendar-plus-o"
                                string="Book Follow-Up"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Patient / المريض">
                            <field name="patient_id" readonly="booking_id"/>
                            <field name="clinic_id" readonly="booking_id"/>
                            <field name="doctor_id" readonly="booking_id" domain="[('clinic_id', '=', clinic_id)]"/>
                            <field name="booking_id" required="1"/>
                            <field name="booking_number" readonly="1"/>
                        </group>
                        <group string="Dates / التواريخ">
                            <field name="create_date_manual"/>
                            <field name="follow_up_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Vital Signs / العلامات الحيوية">
                            <group>
                                <group>
                                    <field name="bp" placeholder="e.g. 120/80"/>
                                    <field name="hr" placeholder="bpm"/>
                                    <field name="temperature" placeholder="°C"/>
                                    <field name="o2_sat" placeholder="%"/>
                                </group>
                                <group>
                                    <field name="weight" placeholder="kg"/>
                                    <field name="height" placeholder="cm"/>
                                    <field name="bmi" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Clinical Notes / الملاحظات السريرية">
                            <field name="chief_complaint"
                                   placeholder="Chief complaint / الشكوى الرئيسية"/>
                            <field name="clinical_notes"
                                   placeholder="Clinical findings and examination notes / نتائج الفحص السريري"/>
                        </page>

                        <page string="Diagnosis / التشخيص">
                            <group><field name="diagnosis_code" placeholder="ICD-10 e.g. J06.9"/><field name="diagnosis" placeholder="Diagnosis / التشخيص"/></group>
                        </page>
                        <page string="Prescriptions / الوصفات الطبية">
                            <field name="prescription_ids" context="{'default_medical_record_id': id}">
                                <list><field name="name"/><field name="prescription_date"/><field name="doctor_id"/><field name="state" widget="badge"/></list>
                            </field>
                        </page>

                        <page string="Medical Report / التقرير الطبي">
                            <field name="report" placeholder="Full medical report / التقرير الطبي الكامل"/>
                        </page>

                        <page string="Examinations / الفحوصات">
                            <field name="examination_ids"
                                   context="{'default_medical_record_id': id}">
                                <list editable="bottom">
                                    <field name="create_date_manual"/>
                                    <field name="examination_name"/>
                                    <field name="examination_type"/>
                                    <field name="examination_fees" string="Fee (SAR)"/>
                                    <field name="result"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <page string="Lab Requests / طلبات المختبر">
                            <field name="lab_request_ids"
                                   context="{'default_medical_record_id': id,
                                             'default_patient_id': patient_id,
                                             'default_doctor_id': doctor_id,
                                             'default_clinic_id': clinic_id}">
                                <list>
                                    <field name="name"/>
                                    <field name="request_date"/>
                                    <field name="line_count" string="Tests #"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_health_medical_record_search" model="ir.ui.view">
        <field name="name">health.medical.record.search</field>
        <field name="model">health.medical.record</field>
        <field name="arch" type="xml">
            <search string="Search Medical Records">
                <field name="patient_name"/>
                <field name="name"/>
                <field name="booking_number"/>
                <field name="doctor_id"/>
                <field name="clinic_id"/>
                <group expand="1" string="Group By">
                    <filter string="Clinic" name="by_clinic" context="{'group_by': 'clinic_id'}"/>
                    <filter string="Doctor" name="by_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="Date" name="by_date" context="{'group_by': 'create_date_manual:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Patient facing — read only -->
    <record id="view_health_medical_record_patient_list" model="ir.ui.view">
        <field name="name">health.medical.record.list.patient</field>
        <field name="model">health.medical.record</field>
        <field name="arch" type="xml">
            <list string="My Medical Records" create="0" delete="0" edit="0">
                <field name="name"/>
                <field name="create_date_manual" string="Visit Date"/>
                <field name="clinic_id"/>
                <field name="doctor_id"/>
                <field name="diagnosis_code"/>
                <field name="diagnosis"/>
                <field name="follow_up_date"/>
            </list>
        </field>
    </record>

    <record id="action_health_medical_record" model="ir.actions.act_window">
        <field name="name">Medical Records / السجلات الطبية</field>
        <field name="res_model">health.medical.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_health_medical_record_search"/>
    </record>
</odoo>
