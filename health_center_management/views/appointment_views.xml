<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Calendar View -->
    <record id="view_health_appointment_calendar" model="ir.ui.view">
        <field name="name">health.appointment.calendar</field>
        <field name="model">health.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments Calendar / تقويم المواعيد"
                      date_start="start_datetime"
                      date_stop="stop_datetime"
                      color="clinic_id"
                      mode="week"
                      quick_create="False">
                <field name="clinic_id" filters="1"/>
                <field name="doctor_id" filters="1"/>
                <field name="state"/>
                <field name="appointment_type"/>
                <field name="patient_id"/>
                <field name="is_available"/>
            </calendar>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_health_appointment_kanban" model="ir.ui.view">
        <field name="name">health.appointment.kanban</field>
        <field name="model">health.appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="False">
                <field name="slot_label"/>
                <field name="clinic_id"/>
                <field name="doctor_id"/>
                <field name="state"/>
                <field name="is_available"/>
                <field name="patient_id"/>
                <field name="appointment_date"/>
                <field name="appointment_time"/>
                <field name="examination_fees"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="appointment_date"/> — <field name="appointment_time"/>
                                    </strong>
                                </div>
                                <div>
                                    <span t-att-class="record.is_available.raw_value ? 'badge bg-success' : 'badge bg-warning'">
                                        <t t-if="record.is_available.raw_value">Available</t>
                                        <t t-else="">Booked</t>
                                    </span>
                                </div>
                            </div>
                            <div>
                                <i class="fa fa-hospital-o"/> <field name="clinic_id"/>
                            </div>
                            <div t-if="record.doctor_id.raw_value">
                                <i class="fa fa-user-md"/> Dr. <field name="doctor_id"/>
                            </div>
                            <div t-if="record.patient_id.raw_value">
                                <i class="fa fa-user"/> <field name="patient_id"/>
                            </div>
                            <div class="text-muted mt-1">
                                <small>Fee: <field name="examination_fees"/> SAR</small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_health_appointment_list" model="ir.ui.view">
        <field name="name">health.appointment.list</field>
        <field name="model">health.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments / المواعيد" default_order="appointment_date,appointment_time">
                <field name="name" string="Appt #"/>
                <field name="clinic_id"/>
                <field name="doctor_id"/>
                <field name="appointment_type"/>
                <field name="appointment_date"/>
                <field name="appointment_time"/>
                <field name="is_available" widget="boolean_toggle"/>
                <field name="patient_id"/>
                <field name="examination_fees" string="Fee (SAR)"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'booked'"
                       decoration-info="state == 'done'"
                       decoration-muted="state == 'no_show'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_health_appointment_form" model="ir.ui.view">
        <field name="name">health.appointment.form</field>
        <field name="model">health.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment / موعد">
                <header>
                    <button name="action_mark_done" string="Mark Done / إنهاء"
                            type="object" class="btn-primary"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_mark_no_show" string="No Show / لم يحضر"
                            type="object" class="btn-secondary"
                            invisible="state != 'booked'"/>
                    <button name="action_cancel" string="Cancel / إلغاء"
                            type="object" class="btn-danger"
                            invisible="state in ('done', 'cancelled')"
                            confirm="Cancel this appointment?"/>
                    <button name="action_reset" string="Reset / إعادة"
                            type="object"
                            invisible="state == 'available'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,booked,done,no_show"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <group>
                        <group string="Appointment Details / تفاصيل الموعد">
                            <field name="name" readonly="1"/>
                            <field name="clinic_id"/>
                            <field name="doctor_id" domain="[('clinic_id', '=', clinic_id)]"/>
                            <field name="appointment_type"/>
                            <field name="appointment_date"/>
                            <field name="appointment_time"/>
                            <field name="duration"/>
                            <field name="examination_fees"/>
                        </group>
                        <group string="Booking Info / معلومات الحجز">
                            <field name="is_available" widget="boolean_toggle"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_health_appointment_search" model="ir.ui.view">
        <field name="name">health.appointment.search</field>
        <field name="model">health.appointment</field>
        <field name="arch" type="xml">
            <search string="Search Appointments / بحث في المواعيد">
                <field name="slot_label"/>
                <field name="clinic_id"/>
                <field name="doctor_id"/>
                <field name="patient_id"/>
                <filter string="Available / متاح" name="available"
                        domain="[('is_available', '=', True)]"/>
                <filter string="Today / اليوم" name="today"
                        domain="[('appointment_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week / هذا الأسبوع" name="this_week"
                        domain="[('appointment_date', '>=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Booked / محجوز" name="booked" domain="[('state', '=', 'booked')]"/>
                <filter string="Done / منتهى" name="done" domain="[('state', '=', 'done')]"/>
                <group expand="1" string="Group By / تجميع">
                    <filter string="Clinic / العيادة" name="by_clinic" context="{'group_by': 'clinic_id'}"/>
                    <filter string="Doctor / الطبيب" name="by_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="Date / التاريخ" name="by_date" context="{'group_by': 'appointment_date:day'}"/>
                    <filter string="Status / الحالة" name="by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_health_appointment" model="ir.actions.act_window">
        <field name="name">Appointments / المواعيد</field>
        <field name="res_model">health.appointment</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="search_view_id" ref="view_health_appointment_search"/>
    </record>
</odoo>
