<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_health_appointment_tree" model="ir.ui.view">
            <field name="name">health.appointment.list</field>
            <field name="model">health.appointment</field>
            <field name="arch" type="xml">
                <list string="Appointments">
                    <field name="clinic_id" string="Clinic"/>
                    <field name="appointment_date" string="Date"/>
                    <field name="appointment_time" string="Time"/>
                    <field name="is_available" string="Available" widget="boolean_toggle"/>
                    <field name="patient_id" string="Booked Patient" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_health_appointment_form" model="ir.ui.view">
            <field name="name">health.appointment.form</field>
            <field name="model">health.appointment</field>
            <field name="arch" type="xml">
                <form string="Appointment">
                    <header>
                        <button name="action_save_confirm"
                                string="✔ Save &amp; Confirm"
                                type="object"
                                class="btn-primary"
                                data-hotkey="s"/>
                        <button string="Discard Changes"
                                class="btn-secondary"
                                special="cancel"
                                confirm="Are you sure you want to discard changes? All unsaved data will be lost."/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Appointment Details">
                                <field name="clinic_id" string="Clinic"/>
                                <field name="appointment_date" string="Date"/>
                                <field name="appointment_time" string="Time"/>
                                <field name="is_available" string="Available"/>
                            </group>
                            <group string="Booking Info">
                                <field name="patient_id" string="Booked Patient" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_health_appointment_calendar" model="ir.ui.view">
            <field name="name">health.appointment.calendar</field>
            <field name="model">health.appointment</field>
            <field name="arch" type="xml">
                <calendar string="Appointments Schedule"
                          date_start="appointment_date"
                          color="clinic_id"
                          mode="month">
                    <field name="clinic_id"/>
                    <field name="appointment_time"/>
                    <field name="is_available"/>
                </calendar>
            </field>
        </record>

        <record id="view_health_appointment_search" model="ir.ui.view">
            <field name="name">health.appointment.search</field>
            <field name="model">health.appointment</field>
            <field name="arch" type="xml">
                <search string="Search Appointments">
                    <field name="clinic_id" string="Clinic"/>
                    <field name="appointment_date" string="Date"/>
                    <filter name="today" string="Today"
                            domain="[('appointment_date', '=', context_today())]"/>
                    <filter name="available" string="Available"
                            domain="[('is_available', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_clinic" string="Clinic"
                                context="{'group_by': 'clinic_id'}"/>
                        <filter name="group_date" string="Date"
                                context="{'group_by': 'appointment_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_health_appointment_employee" model="ir.actions.act_window">
            <field name="name">Manage Appointments</field>
            <field name="res_model">health.appointment</field>
            <field name="view_mode">list,calendar,form</field>
            <field name="search_view_id" ref="view_health_appointment_search"/>
            <field name="context">{'search_default_today': 1}</field>
            <field name="groups_id" eval="[(4, ref('health_center_management.group_health_employee'))]"/>
        </record>

    </data>
</odoo>
