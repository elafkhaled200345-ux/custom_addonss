<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_invoice_list" model="ir.ui.view">
        <field name="name">health.invoice.list</field><field name="model">health.invoice</field>
        <field name="arch" type="xml"><list string="Invoices / الفواتير" default_order="id desc">
            <field name="name"/><field name="patient_name"/><field name="booking_id" optional="show"/><field name="clinic_id"/>
            <field name="invoice_date"/><field name="currency_id"/><field name="total_amount" sum="Total"/>
            <field name="amount_paid"/><field name="remaining_balance"/><field name="invoice_status" widget="badge" decoration-success="invoice_status == 'paid'" decoration-warning="invoice_status in ('unpaid','partial')" decoration-info="invoice_status == 'insurance_pending'" decoration-danger="invoice_status == 'cancelled'"/>
        </list></field>
    </record>
    <record id="view_health_invoice_form" model="ir.ui.view">
        <field name="name">health.invoice.form</field><field name="model">health.invoice</field>
        <field name="arch" type="xml">
            <form string="Health Invoice / فاتورة صحية">
                <header><button name="action_mark_paid" string="Mark Paid / تسجيل دفع" type="object" class="btn-success" invisible="invoice_status in ('paid','cancelled')"/><button name="action_print_invoice" string="Print / طباعة" type="object"/><button name="action_cancel" string="Cancel / إلغاء" type="object" class="btn-danger" invisible="invoice_status == 'cancelled'"/><field name="invoice_status" widget="statusbar"/></header>
                <sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group><group string="Visit / الزيارة"><field name="booking_id" required="1"/><field name="patient_id" readonly="booking_id"/><field name="clinic_id" readonly="booking_id"/><field name="appointment_id" readonly="booking_id"/><field name="examination_id"/></group><group string="Invoice / الفاتورة"><field name="invoice_date"/><field name="currency_id"/><field name="receipt_number" readonly="1"/></group></group>
                    <group><group string="Amounts / المبالغ"><field name="consultation_fee"/><field name="examination_fee" readonly="1"/><field name="discount"/><field name="tax"/><field name="tax_amount" readonly="1"/><field name="total_amount" readonly="1"/></group><group string="Payment / الدفع"><field name="payment_method"/><field name="transaction_number"/><field name="amount_paid"/><field name="remaining_balance" readonly="1"/><field name="payment_date"/><field name="insurance_company" readonly="1"/><field name="insurance_number" readonly="1"/></group></group>
                    <field name="notes" placeholder="Notes / ملاحظات"/>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="view_health_invoice_search" model="ir.ui.view"><field name="name">health.invoice.search</field><field name="model">health.invoice</field><field name="arch" type="xml"><search><field name="name"/><field name="patient_id"/><field name="booking_id"/><field name="clinic_id"/><filter string="Unpaid" name="unpaid" domain="[('invoice_status','in',('unpaid','partial'))]"/><filter string="Paid" name="paid" domain="[('invoice_status','=','paid')]"/><group expand="1" string="Group By"><filter string="Clinic" name="by_clinic" context="{'group_by':'clinic_id'}"/><filter string="Status" name="by_status" context="{'group_by':'invoice_status'}"/></group></search></field></record>
    <record id="action_health_invoice" model="ir.actions.act_window"><field name="name">Invoices / الفواتير</field><field name="res_model">health.invoice</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_health_invoice_search"/></record>
</odoo>
