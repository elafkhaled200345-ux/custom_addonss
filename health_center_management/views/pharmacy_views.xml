<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Medicine Catalogue -->
    <record id="view_health_medicine_list" model="ir.ui.view">
        <field name="name">health.medicine.list</field>
        <field name="model">health.medicine</field>
        <field name="arch" type="xml">
            <list string="Medicines / الأدوية" default_order="name">
                <field name="name"/>
                <field name="generic_name"/>
                <field name="category"/>
                <field name="dosage_form"/>
                <field name="strength"/>
                <field name="unit_price" string="Price (SAR)"/>
                <field name="qty_available" string="In Stock"/>
                <field name="reorder_level" optional="show"/>
                <field name="low_stock" string="Low Stock" widget="boolean"
                       optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_health_medicine_form" model="ir.ui.view">
        <field name="name">health.medicine.form</field>
        <field name="model">health.medicine</field>
        <field name="arch" type="xml">
            <form string="Medicine / دواء">
                <sheet>
                    <widget name="web_ribbon" title="Low Stock / مخزون منخفض"
                            bg_color="bg-warning"
                            invisible="not low_stock"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Medicine Name / اسم الدواء"/></h1>
                        <h3 class="text-muted">
                            <field name="generic_name" placeholder="Generic Name / الاسم العلمي"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Classification / التصنيف">
                            <field name="category"/>
                            <field name="dosage_form"/>
                            <field name="strength"/>
                        </group>
                        <group string="Stock &amp; Pricing / المخزون والتسعير">
                            <field name="unit_price"/>
                            <field name="qty_available"/>
                            <field name="reorder_level"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes / ملاحظات"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Dispense Orders -->
    <record id="view_health_pharmacy_dispense_list" model="ir.ui.view">
        <field name="name">health.pharmacy.dispense.list</field>
        <field name="model">health.pharmacy.dispense</field>
        <field name="arch" type="xml">
            <list string="Pharmacy Dispenses / صرف الصيدلية" default_order="id desc">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="dispense_date"/>
                <field name="dispensed_by"/>
                <field name="total_amount" string="Total (SAR)" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'dispensed'"
                       decoration-muted="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_health_pharmacy_dispense_form" model="ir.ui.view">
        <field name="name">health.pharmacy.dispense.form</field>
        <field name="model">health.pharmacy.dispense</field>
        <field name="arch" type="xml">
            <form string="Pharmacy Dispense / صرف دواء">
                <header>
                    <button name="action_dispense" string="✔ Dispense / صرف"
                            type="object" class="btn-success"
                            invisible="state != 'draft'"
                            confirm="Confirm dispensing? This will deduct from stock."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,dispensed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="medical_record_id"/>
                        </group>
                        <group>
                            <field name="dispense_date"/>
                            <field name="dispensed_by" readonly="1"/>
                            <field name="total_amount" readonly="1" class="o_bold"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="medicine_id"/>
                            <field name="dosage_form" readonly="1"/>
                            <field name="quantity"/>
                            <field name="unit_price" readonly="1"/>
                            <field name="batch_number"/>
                            <field name="expiry_date"/>
                            <field name="subtotal" readonly="1"/>
                            <field name="dosage_instructions"/>
                        </list>
                    </field>
                    <field name="notes" placeholder="Notes / ملاحظات"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_health_medicine" model="ir.actions.act_window">
        <field name="name">Medicines / الأدوية</field>
        <field name="res_model">health.medicine</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_health_pharmacy_dispense" model="ir.actions.act_window">
        <field name="name">Pharmacy Dispenses / صرف الصيدلية</field>
        <field name="res_model">health.pharmacy.dispense</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_health_pharmacy" model="ir.actions.act_window">
        <field name="name">Pharmacy / الصيدلية</field>
        <field name="res_model">health.pharmacy.dispense</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_health_medicine_low_stock" model="ir.actions.act_window">
        <field name="name">Low Stock Alert / تنبيه مخزون منخفض</field>
        <field name="res_model">health.medicine</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('qty_available', '&lt;=', 0)]</field>
    </record>
</odoo>
