<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Login form -->
    <record id="view_health_report_portal_login_form" model="ir.ui.view">
        <field name="name">health.report.portal.login.form</field>
        <field name="model">health.report.portal.login</field>
        <field name="arch" type="xml">
            <form string="Reports Portal / بوابة التقارير">
                <sheet>
                    <div class="text-center mb-4">
                        <h2>📊 Reports Portal / بوابة التقارير</h2>
                        <p class="text-muted">
                            أدخل كلمة المرور للوصول إلى التقارير
                        </p>
                    </div>
                    <group>
                        <field name="password" password="True"
                               placeholder="كلمة المرور / Password"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_verify" string="🔑 Login / دخول"
                            type="object" class="btn-primary"/>
                    <button string="Cancel / إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Reports Hub form -->
    <record id="view_health_report_hub_form" model="ir.ui.view">
        <field name="name">health.report.hub.form</field>
        <field name="model">health.report.hub</field>
        <field name="arch" type="xml">
            <form string="Reports Hub / مركز التقارير"
                  create="false" delete="false">
                <sheet>
                    <div class="text-center mb-4">
                        <h2>📊 Reports Hub / مركز التقارير</h2>
                        <p class="text-muted">اختر نوع التقرير ثم اضغط عرض أو طباعة</p>
                    </div>
                    <group>
                        <field name="report_type" widget="radio"/>
                    </group>
                    <div class="row mt-4 text-center">
                        <div class="col-6">
                            <button name="action_open_list" type="object"
                                    class="btn btn-primary btn-lg w-100 py-3">
                                <i class="fa fa-list fa-lg d-block mb-1"/>
                                📋 View Records / عرض السجلات
                            </button>
                        </div>
                        <div class="col-6">
                            <button name="action_print_pdf" type="object"
                                    class="btn btn-success btn-lg w-100 py-3">
                                <i class="fa fa-print fa-lg d-block mb-1"/>
                                🖨️ Print PDF / طباعة PDF
                            </button>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_health_report_portal_login" model="ir.actions.act_window">
        <field name="name">Reports Portal / بوابة التقارير</field>
        <field name="res_model">health.report.portal.login</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
