<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_contact_form" model="ir.ui.view">
        <field name="name">health.contact.settings.form</field>
        <field name="model">health.contact.settings</field>
        <field name="arch" type="xml">
            <form string="Contact Information / معلومات التواصل">
                <sheet>
                    <group>
                        <group string="Identity / الهوية">
                            <field name="logo" widget="image" class="oe_avatar"/>
                            <field name="center_name"/>
                            <field name="website"/>
                        </group>
                        <group string="Contact / التواصل">
                            <field name="phone"/>
                            <field name="phone2"/>
                            <field name="whatsapp"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <group>
                        <field name="address"/>
                        <field name="working_hours"/>
                    </group>
                    <group string="Social Media / وسائل التواصل الاجتماعي">
                        <group>
                            <field name="social_twitter"/>
                            <field name="social_instagram"/>
                        </group>
                        <group>
                            <field name="social_snapchat"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Read-only for all users -->
    <record id="view_health_contact_patient_form" model="ir.ui.view">
        <field name="name">health.contact.settings.form.patient</field>
        <field name="model">health.contact.settings</field>
        <field name="arch" type="xml">
            <form string="Contact Us / تواصل معنا" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="center_name" readonly="1"/>
                            <field name="phone" readonly="1"/>
                            <field name="phone2" readonly="1"/>
                            <field name="whatsapp" readonly="1"/>
                            <field name="email" readonly="1"/>
                        </group>
                        <group>
                            <field name="working_hours" readonly="1"/>
                            <field name="address" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_health_contact_info" model="ir.actions.act_window">
        <field name="name">Contact Us / تواصل معنا</field>
        <field name="res_model">health.contact.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_health_contact_patient_form"/>
        <field name="target">new</field>
    </record>

    <record id="action_health_contact_edit" model="ir.actions.act_window">
        <field name="name">Contact Settings / إعدادات التواصل</field>
        <field name="res_model">health.contact.settings</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
