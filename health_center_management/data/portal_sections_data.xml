<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Employee Portal Sections -->
    <record id="portal_section_patients" model="health.portal.section">
        <field name="sequence">1</field>
        <field name="name">Patients / المرضى</field>
        <field name="portal_type">employee</field>
        <field name="icon">fa-user</field>
    </record>
    <record id="portal_section_bookings" model="health.portal.section">
        <field name="sequence">2</field>
        <field name="name">Bookings / الحجوزات</field>
        <field name="portal_type">employee</field>
        <field name="icon">fa-calendar</field>
    </record>
    <record id="portal_section_invoices" model="health.portal.section">
        <field name="sequence">3</field>
        <field name="name">Invoices / الفواتير</field>
        <field name="portal_type">employee</field>
        <field name="icon">fa-file-text</field>
    </record>
    <record id="portal_section_pharmacy" model="health.portal.section">
        <field name="sequence">4</field>
        <field name="name">Pharmacy / الصيدلية</field>
        <field name="portal_type">employee</field>
        <field name="icon">fa-medkit</field>
    </record>
    <!-- Doctor Portal Sections -->
    <record id="portal_section_doctor_records" model="health.portal.section">
        <field name="sequence">1</field>
        <field name="name">Medical Records / السجلات الطبية</field>
        <field name="portal_type">doctor</field>
        <field name="icon">fa-stethoscope</field>
    </record>
    <record id="portal_section_doctor_examinations" model="health.portal.section">
        <field name="sequence">2</field>
        <field name="name">Examinations / الفحوصات</field>
        <field name="portal_type">doctor</field>
        <field name="icon">fa-heartbeat</field>
    </record>
    <record id="portal_section_doctor_lab" model="health.portal.section">
        <field name="sequence">3</field>
        <field name="name">Lab Requests / طلبات المختبر</field>
        <field name="portal_type">doctor</field>
        <field name="icon">fa-flask</field>
    </record>
</odoo>
