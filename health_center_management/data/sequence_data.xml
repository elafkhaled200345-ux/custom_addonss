<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_health_appointment" model="ir.sequence">
        <field name="name">Health Appointment</field>
        <field name="code">health.appointment</field>
        <field name="prefix">APT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_health_booking" model="ir.sequence">
        <field name="name">Health Booking</field>
        <field name="code">health.booking</field>
        <field name="prefix">BKG/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_health_medical_record" model="ir.sequence">
        <field name="name">Health Medical Record</field>
        <field name="code">health.medical.record</field>
        <field name="prefix">MR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_health_examination" model="ir.sequence">
        <field name="name">Health Examination</field>
        <field name="code">health.examination</field>
        <field name="prefix">EXM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_health_lab_request" model="ir.sequence">
        <field name="name">Health Lab Request</field>
        <field name="code">health.lab.request</field>
        <field name="prefix">LAB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_health_invoice" model="ir.sequence">
        <field name="name">Health Invoice</field>
        <field name="code">health.invoice</field>
        <field name="prefix">INV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_health_pharmacy_dispense" model="ir.sequence">
        <field name="name">Health Pharmacy Dispense</field>
        <field name="code">health.pharmacy.dispense</field>
        <field name="prefix">PHR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

