        <field name="name">Health Booking Queue</field>
        <field name="code">health.booking.queue</field>
        <field name="prefix">Q/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_health_prescription" model="ir.sequence">
        <field name="name">Health Prescription</field>
        <field name="code">health.prescription</field>
        <field name="prefix">RX/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_health_invoice_receipt" model="ir.sequence">
        <field name="name">Health Invoice Receipt</field>
        <field name="code">health.invoice.receipt</field>
        <field name="prefix">RCT/%(year)s/</field>
        <field name="padding">5</field>
    </record>
</odoo>
