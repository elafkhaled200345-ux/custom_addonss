<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_health_center" model="ir.module.category">
            <field name="name">Health Center Management</field>
            <field name="description">Patient Services Management System for Health Centers</field>
            <field name="sequence">10</field>
        </record>

        <!-- Patient Group -->
        <record id="group_health_patient" model="res.groups">
            <field name="name">Patient</field>
            <field name="category_id" ref="module_category_health_center"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Doctor Group -->
        <record id="group_health_doctor" model="res.groups">
            <field name="name">Doctor</field>
            <field name="category_id" ref="module_category_health_center"/>
            <field name="implied_ids" eval="[(4, ref('group_health_patient'))]"/>
        </record>

        <!-- Employee Group -->
        <record id="group_health_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_category_health_center"/>
            <field name="implied_ids" eval="[(4, ref('group_health_doctor'))]"/>

            <!-- Give Administrator access automatically -->
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
