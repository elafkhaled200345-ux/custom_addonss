<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      <!-- ═══════════════════════════════════════════════════════════════
           RECORD RULES
           ─ Patient    → يرى بياناته الخاصة فقط (عبر user_id)
           ─ Doctor     → يرى بيانات مرضاه فقط  (عبر doctor_id.user_id)
           ─ Employee   → يرى كل شيء            (domain_force: [(1,'=',1)])
           التسلسل الهرمي: Employee ← Doctor ← Patient
           عند تقييم ir.rules يُطبَّق OR على جميع rules المجموعات.
           الموظف (employee) يرث Doctor، فتُطبَّق عليه employee_all → يرى الكل.
           الطبيب (doctor فقط، غير موظف) تُطبَّق عليه doctor_own فقط.
           شرط: يجب ربط الطبيب بـ user_id في سجله قبل تفعيل قواعد الطبيب.
      ═══════════════════════════════════════════════════════════════ -->

      <!-- ─────────────────────────────────────────────────────────────
           PATIENT RULES — المريض يرى بياناته فقط (via user_id)
      ───────────────────────────────────────────────────────────────── -->

      <!-- health.patient -->
      <record id="rule_health_patient_own" model="ir.rule">
          <field name="name">Patient: own record only</field>
          <field name="model_id" ref="model_health_patient"/>
          <field name="domain_force">[('user_id', '=', user.id)]</field>
          <field name="groups" eval="[(4, ref('group_health_patient'))]"/>
          <field name="perm_read" eval="True"/>
          <field name="perm_write" eval="True"/>
          <field name="perm_create" eval="True"/>
          <field name="perm_unlink" eval="False"/>
      </record>
      <record id="rule_health_patient_employee_all" model="ir.rule">
          <field name="name">Employee/Doctor: all patient records</field>
          <field name="model_id" ref="model_health_patient"/>
          <field name="domain_force">[(1, '=', 1)]</field>
          <field name="groups" eval="[(4, ref('group_health_employee'))]"/>
      </record>

      <!-- health.medical.record -->
      <record id="rule_health_medical_record_own" model="ir.rule">
          <field name="name">Patient: own medical records only</field>
          <field name="model_id" ref="model_health_medical_record"/>
          <field name="domain_force">[('patient_id.user_id', '=', user.id)]</field>
          <field name="groups" eval="[(4, ref('group_health_patient'))]"/>
          <field name="perm_read" eval="True"/>
          <field name="perm_write" eval="False"/>
          <field name="perm_create" eval="False"/>
          <field name="perm_unlink" eval="False"/>
      </record>
      <record id="rule_health_medical_record_employee_all" model="ir.rule">
          <field name="name">Employee/Doctor: all medical records</field>
          <field name="model_id" ref="model_health_medical_record"/>
