<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_health_lab_request" model="ir.actions.report">
        <field name="name">Lab Test Request / طلب فحص مختبر</field>
        <field name="model">health.lab.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">health_center_management.report_lab_request_template</field>
        <field name="report_file">health_center_management.report_lab_request_template</field>
        <field name="print_report_name">'LabRequest_' + object.name</field>
        <field name="binding_model_id" ref="model_health_lab_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_lab_request_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>Laboratory Test Request / طلب فحص مختبر</h2>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <table class="table table-sm table-bordered">
                                    <tr>
                                        <th class="bg-light">Request # / رقم الطلب</th>
                                        <td><t t-esc="o.name"/></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Patient / المريض</th>
                                        <td><t t-esc="o.patient_name"/></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Age / العمر</th>
                                        <td><t t-esc="o.age"/> years</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Date / التاريخ</th>
                                        <td><t t-esc="o.request_date"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-bordered">
                                    <tr>
                                        <th class="bg-light">Doctor / الطبيب</th>
                                        <td>Dr. <t t-esc="o.doctor_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Clinic / العيادة</th>
                                        <td><t t-esc="o.clinic_id.name or '—'"/></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Priority / الأولوية</th>
                                        <td><t t-esc="o.priority"/></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Diagnosis / التشخيص</th>
                                        <td><t t-esc="o.diagnosis or '—'"/></td>
                                    </tr>
                                </table>
                                <p t-if="o.collected_date">Collected: <t t-esc="o.collected_date"/></p>
                                <p t-if="o.result_date">Result: <t t-esc="o.result_date"/></p>
                            </div>
                        </div>

                        <t t-if="o.line_ids">
                            <h5 class="mt-3">Requested Tests / الفحوصات المطلوبة</h5>
                            <table class="table table-bordered table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Test Name / الفحص</th>
                                        <th>Category / التصنيف</th>
                                        <th>Result / النتيجة</th>
                                        <th>Normal Range / المعدل الطبيعي</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.line_ids" t-as="line">
                                        <tr>
                                            <td><t t-esc="line_index + 1"/></td>
                                            <td><t t-esc="line.test_name"/></td>
                                            <td><t t-esc="line.test_category"/></td>
                                            <td><t t-esc="line.result or ''"/></td>
                                            <td><t t-esc="line.normal_range or ''"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="o.additional_notes">
                            <h6 class="mt-3">Notes / ملاحظات</h6>
                            <p><t t-esc="o.additional_notes"/></p>
                        </t>

                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <div class="border-top pt-2">Requesting Doctor / توقيع الطبيب</div>
                            </div>
                            <div class="col-6 text-center">
                                <div class="border-top pt-2">Lab Technician / فني المختبر</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
