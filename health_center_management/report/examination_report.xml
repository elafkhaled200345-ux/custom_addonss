<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_health_examination" model="ir.actions.report">
        <field name="name">Medical Examination Report / تقرير الفحص الطبي</field>
        <field name="model">health.examination</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">health_center_management.report_examination_template</field>
        <field name="report_file">health_center_management.report_examination_template</field>
        <field name="print_report_name">'Examination_' + object.name</field>
        <field name="binding_model_id" ref="model_health_examination"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_examination_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row">
                            <div class="col-12 text-center mb-4">
                                <h2>Medical Examination Report / تقرير الفحص الطبي</h2>
                                <h4 class="text-muted"><t t-esc="o.name"/></h4>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <table class="table table-sm table-bordered">
                                    <tr>
                                        <th class="bg-light">Patient Name / المريض</th>
                                        <td><t t-esc="o.patient_name"/></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Booking # / رقم الحجز</th>
                                        <td><t t-esc="o.booking_number"/></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Clinic / العيادة</th>
                                        <td><t t-esc="o.clinic_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Doctor / الطبيب</th>
                                        <td>Dr. <t t-esc="o.doctor_id.name or '—'"/></td>
                                    </tr>
                                <tr t-if="o.performed_by"><th class="bg-light">Performed By</th><td><t t-esc="o.performed_by.name"/></td></tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-bordered">
                                    <tr>
                                        <th class="bg-light">Examination / الفحص</th>
                                        <td><t t-esc="o.examination_name"/></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Type / النوع</th>
                                        <td><t t-esc="o.examination_type"/></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Date / التاريخ</th>
                                        <td><t t-esc="o.create_date_manual"/></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Fee (SAR) / الرسوم</th>
                                        <td><t t-esc="o.examination_fees"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <t t-if="o.result">
                            <h5 class="mt-4">Examination Result / نتيجة الفحص</h5>
                            <div class="border p-3 mb-3">
                                <p><t t-esc="o.result"/></p>
                            </div>
                        </t>

                        <t t-if="o.prescription">
                            <h5 class="mt-4">Drug Prescription / الوصفة الطبية</h5>
                            <div class="border p-3 mb-3">
                                <p><t t-esc="o.prescription"/></p>
                            </div>
                        </t>

                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <div class="border-top pt-2">Doctor's Signature / توقيع الطبيب</div>
                            </div>
                            <div class="col-6 text-center">
                                <div class="border-top pt-2">Stamp / الختم</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
