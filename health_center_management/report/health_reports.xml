<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Booking Report -->
    <record id="report_health_booking" model="ir.actions.report">
        <field name="name">Booking Confirmation / تأكيد الحجز</field>
        <field name="model">health.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">health_center_management.report_booking_template</field>
        <field name="print_report_name">'Booking_' + object.name</field>
        <field name="binding_model_id" ref="model_health_booking"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_booking_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>Booking Confirmation / تأكيد الحجز</h2>
                        </div>
                        <table class="table table-bordered">
                            <tr><th class="bg-light">Booking # / رقم الحجز</th><td><t t-esc="o.name"/></td></tr>
                            <tr><th class="bg-light">Patient / المريض</th><td><t t-esc="o.patient_name"/></td></tr>
                            <tr><th class="bg-light">Clinic / العيادة</th><td><t t-esc="o.clinic_id.name or '—'"/></td></tr>
                            <tr><th class="bg-light">Doctor / الطبيب</th><td>Dr. <t t-esc="o.doctor_id.name or '—'"/></td></tr>
                            <tr><th class="bg-light">Date / التاريخ</th><td><t t-esc="o.booking_date"/></td></tr>
                            <tr><th class="bg-light">Status / الحالة</th><td><t t-esc="o.state"/></td></tr>
                        </table>
                        <div class="text-center mt-4">
                            <p class="text-muted">
                                Please arrive 15 minutes before your appointment.
                                <br/>يرجى الحضور قبل موعدك بـ ١٥ دقيقة.
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Medical Record Report -->
    <record id="report_health_medical_record" model="ir.actions.report">
        <field name="name">Medical Record / السجل الطبي</field>
        <field name="model">health.medical.record</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">health_center_management.report_medical_record_template</field>
        <field name="print_report_name">'MedicalRecord_' + object.name</field>
        <field name="binding_model_id" ref="model_health_medical_record"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_medical_record_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-3">
                            <h2>Medical Record / السجل الطبي</h2>
                            <h4 class="text-muted"><t t-esc="o.name"/></h4>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <table class="table table-sm table-bordered">
                                    <tr><th class="bg-light">Patient</th><td><t t-esc="o.patient_name"/></td></tr>
                                    <tr><th class="bg-light">Clinic</th><td><t t-esc="o.clinic_id.name"/></td></tr>
                                    <tr><th class="bg-light">Doctor</th><td>Dr. <t t-esc="o.doctor_id.name or '—'"/></td></tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-bordered">
                                    <tr><th class="bg-light">Visit Date</th><td><t t-esc="o.create_date_manual"/></td></tr>
                                    <tr><th class="bg-light">Follow-Up</th><td><t t-esc="o.follow_up_date or '—'"/></td></tr>
                                    <tr><th class="bg-light">Booking #</th><td><t t-esc="o.booking_number or '—'"/></td></tr>
                                </table>
                            </div>
                        </div>
                        <t t-if="o.bp or o.hr or o.temperature or o.o2_sat">
                            <h5>Vital Signs / العلامات الحيوية</h5>
                            <table class="table table-sm table-bordered mb-3">
                                <tr>
                                    <th>BP</th><td><t t-esc="o.bp or '—'"/></td>
                                    <th>HR</th><td><t t-esc="o.hr or '—'"/> bpm</td>
                                    <th>Temp</th><td><t t-esc="o.temperature or '—'"/> °C</td>
                                    <th>O2</th><td><t t-esc="o.o2_sat or '—'"/>%</td>
                                </tr>
                            </table>
                        </t>
                        <t t-if="o.diagnosis">
                            <h5>Diagnosis / التشخيص</h5>
                            <div class="border p-2 mb-3"><strong t-if="o.diagnosis_code"><t t-esc="o.diagnosis_code"/> — </strong><t t-esc="o.diagnosis"/></div>
                        </t>
                        <t t-if="o.prescription_ids">
                            <h5>Prescriptions / الوصفات الطبية</h5>
                            <t t-foreach="o.prescription_ids" t-as="rx">
                                <table class="table table-sm table-bordered mb-3">
                                    <thead><tr><th>Medicine</th><th>Qty</th><th>Dosage</th><th>Duration</th></tr></thead>
                                    <tbody><t t-foreach="rx.line_ids" t-as="line"><tr>
                                        <td><t t-esc="line.medicine_id.name"/></td><td><t t-esc="line.quantity"/></td>
                                        <td><t t-esc="line.dosage_instructions"/></td><td><t t-esc="line.duration or '—'"/></td>
                                    </tr></t></tbody>
                                </table>
                            </t>
                        </t>
                        <t t-if="o.report">
                            <h5>Medical Report / التقرير الطبي</h5>
                            <div class="border p-2 mb-3"><t t-esc="o.report"/></div>
                        </t>
                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <div class="border-top pt-2">Doctor's Signature</div>
                            </div>
                            <div class="col-6 text-center">
                                <div class="border-top pt-2">Official Stamp</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
